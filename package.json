{
  "name": "cyberspace-core",
  "version": "0.2.1",
  "description": "TypeScript implementation of the Cyberspace Protocol v2 core: Cantor pairing, 256-bit interleaved coordinates, movement proofs, terrain K, sectors, and location-based key derivation.",
  "license": "MIT",
  "repository": "https://github.com/arkin0x/cyberspace-cli-js",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "grandfathered": "node scripts/grandfathered.mjs",
    "build:kernel": "node scripts/build-kernel.mjs",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "assemblyscript": "0.28.20",
    "gmp-wasm": "1.3.2",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
